# ─────────────────────────────────────────────────────────────
# Quill — environment variables
# Copy to .env and fill in values for local development.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
POSTGRES_USER="quill_user"
POSTGRES_PASSWORD="quill_password"
POSTGRES_DB="quill_db"
POSTGRES_PORT=5432

# Connection string used by Prisma (apps/api).
# For local dev this points at localhost. Docker Compose injects its own
# container-network DATABASE_URL for the api service.
DATABASE_URL="postgresql://quill_user:quill_password@localhost:5432/quill_db?schema=public"

# Docker Compose defaults. Kept separate from local POSTGRES_* so an existing
# local .env cannot accidentally point containers at localhost.
DOCKER_POSTGRES_USER="quill_user"
DOCKER_POSTGRES_PASSWORD="quill_password"
DOCKER_POSTGRES_DB="quill_db"
DOCKER_POSTGRES_PORT=5432

# ── API (apps/api) ──────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# JWT — generate strong random values for production
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie domain for refresh token (leave blank for localhost)
COOKIE_DOMAIN=

# CORS — comma-separated list of allowed origins for the web app
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ──────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
