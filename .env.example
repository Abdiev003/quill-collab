# ─────────────────────────────────────────────────────────────
# Quill — environment variables
# Copy to .env and fill in values for local development.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
POSTGRES_USER="quill_user"
POSTGRES_PASSWORD="mL#hix.p(gL6Zi_<Ey,g]R|4"
POSTGRES_DB="quill_db"
POSTGRES_PORT=5432

# Connection string used by Prisma (apps/api).
# Password is URL-encoded — keep this in sync with POSTGRES_PASSWORD above.
DATABASE_URL="postgresql://quill_user:mL%23hix.p%28gL6Zi_%3CEy%2Cg%5DR%7C4@localhost:5432/quill_db?schema=public"

# ── API (apps/api) ──────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# JWT — generate strong random values for production
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie domain for refresh token (leave blank for localhost)
COOKIE_DOMAIN=

# CORS — comma-separated list of allowed origins for the web app
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
